# ═══════════════════════════════════════════════════════════════════════════
# Rio Tourism AI Agent - Variáveis de Ambiente
# ═══════════════════════════════════════════════════════════════════════════
# 
# INSTRUÇÕES:
# 1. Copie este arquivo: cp .env.example .env
# 2. Preencha os valores com suas credenciais reais
# 3. NUNCA commite o arquivo .env no Git (está no .gitignore)
#
# ═══════════════════════════════════════════════════════════════════════════

# APIs de Terceiros
# Obtenha em: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_key_here

# Modelo usado no OpenRouter (opcional - troque sem mexer em código)
OPENROUTER_MODEL=deepseek/deepseek-v4-flash-0731

# Obtenha em: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_key_here

# Obtenha em: https://developers.google.com/maps
GOOGLE_PLACES_API_KEY=your_google_places_key_here

# ChromaDB - Banco Vetorial Local
# Caminho relativo e resolvido a partir da raiz do projeto, nao do diretorio atual.
# ATENCAO: se o projeto estiver em pasta sincronizada (OneDrive, Dropbox, Google Drive),
# use um caminho ABSOLUTO fora dela (ex: C:/Users/<voce>/chroma_db_rio). A sincronizacao
# trava/move os arquivos do indice HNSW durante a escrita e corrompe a base
# ("Error loading hnsw index").
CHROMA_DB_PATH=./chroma_db_rio

# Memoria de conversa do agente (historico por thread_id, em SQLite).
# Mesma regra do CHROMA_DB_PATH: relativo e ancorado na raiz do projeto, e em pasta
# sincronizada (OneDrive etc.) use um caminho ABSOLUTO fora dela.
AGENT_MEMORY_PATH=./agent_memory.sqlite

# Modelo de embedding da base vetorial.
# ATENCAO: trocar este valor INVALIDA a base - vetores de modelos diferentes nao
# sao comparaveis. A collection e recriada automaticamente e os documentos precisam
# ser recarregados (materializar riotur_documents + chromadb_turismo_rio).
# O padrao tem janela de 512 tokens, que cobre a base inteira sem truncar.
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
